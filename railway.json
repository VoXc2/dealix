{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/*.py",
      "/**/*.py",
      "/Dockerfile",
      "/railway.json",
      "/pyproject.toml",
      "/requirements*.txt",
      "/scripts/railway_predeploy.sh",
      "/api/**",
      "/app/**",
      "/db/**",
      "/config/**",
      "/templates/**",
      "/prompts/**"
    ]
  },
  "deploy": {
    "startCommand": null,
    "preDeployCommand": "if [ -x /app/scripts/railway_predeploy.sh ]; then bash /app/scripts/railway_predeploy.sh; else echo 'RAILWAY_PREDEPLOY: no predeploy script'; fi",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
