{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/*.py", "/**/*.py", "/Dockerfile", "/pyproject.toml", "/requirements*.txt", "/scripts/railway_predeploy.sh", "/api/**", "/app/**", "/db/**", "/config/**", "/templates/**", "/prompts/**"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
