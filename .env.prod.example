# Dealix self-hosted production environment template.
# Copy to .env.prod on the VPS and replace every CHANGE_ME value.
# NEVER commit .env.prod or real credentials.

APP_ENV=production
ENVIRONMENT=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_URL=https://api.dealix.me
BASE_URL=https://api.dealix.me
DEALIX_API_BASE=https://api.dealix.me

# Canonical self-host release identity; fill from the exact accepted source at execution time.
DEALIX_GIT_SHA=CHANGE_ME_FULL_40_CHAR_GIT_SHA
DEALIX_IMAGE_TAG=CHANGE_ME_12_CHAR_GIT_SHA
DEALIX_APP_ENV=production
DEALIX_DATABASE_URL=postgresql+asyncpg://dealix:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/dealix
DEALIX_SELFHOST_DB_PORT=15432
DEALIX_PRODUCTION_PROJECT_NAME=dealix-production
CORS_ORIGINS=https://dealix.me,https://www.dealix.me

APP_SECRET_KEY=CHANGE_ME_64_HEX
JWT_SECRET_KEY=CHANGE_ME_64_HEX
API_KEYS=CHANGE_ME_API_KEY
ADMIN_API_KEYS=CHANGE_ME_ADMIN_KEY

POSTGRES_USER=dealix
POSTGRES_DB=dealix
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
PGBOUNCER_MAX_CLIENT_CONN=300
PGBOUNCER_DEFAULT_POOL_SIZE=30

DEALIX_ORCHESTRATOR_BACKEND=postgres
PROOF_LEDGER_BACKEND=postgres
VALUE_LEDGER_BACKEND=postgres
DEALIX_OPERATIONAL_STREAM_BACKEND=postgres

EXTERNAL_SEND_ENABLED=false
AUTO_SEND_ENABLED=false
EXTERNAL_OUTREACH_ENABLED=false
OUTBOUND_MODE=draft_only
EMAIL_SEND_ENABLED=false
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ALLOW_LIVE_SEND=false
PAYMENT_EXECUTION=0

NEXT_PUBLIC_API_URL=https://api.dealix.me
NEXT_PUBLIC_SITE_URL=https://dealix.me
DEALIX_DOMAIN=dealix.me
DEALIX_API_DOMAIN=api.dealix.me
DEALIX_FRONTEND_UPSTREAM=web:3000
ACME_EMAIL=admin@dealix.me
