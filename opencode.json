{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push origin main": "deny",
      "git push origin main *": "deny",
      "git push * main": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git update-ref refs/heads/main*": "deny",
      "git reset --hard origin/main*": "deny",
      "gh pr merge*": "deny",
      "gh pr ready*": "deny",
      "gh merge*": "deny",
      "railway up*": "deny",
      "railway redeploy*": "deny",
      "railway environment*production*": "deny",
      "vercel*": "deny",
      "wrangler deploy*": "deny",
      "alembic upgrade head*": "deny",
      "alembic downgrade*": "deny",
      "kubectl delete*": "deny",
      "docker push*": "deny",
      "sudo*": "ask"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:4b-instruct-2507-q4_K_M": {
          "name": "Qwen3-4B bounded"
        }
      }
    }
  },
  "model": "ollama/qwen3:4b-instruct-2507-q4_K_M"
}