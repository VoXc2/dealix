      "real_inbound_or_event_relationship_with_near_term_conversion",
      "qualified_paid_pilot_path",
      "customer_delivery_and_payment_proof",
      "brand_distribution_that_supports_current_buying_motion",
      "product_or_automation_improvement_with_evidence",
      "general_research_or_backlog_cleanup"
