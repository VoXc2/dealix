{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealix.sa/schemas/model_registry.schema.json",
  "title": "Model Registry Entry",
  "type": "object",
  "required": [
    "model_id",
    "provider",
    "model_name",
    "cost_class",
    "allowed_tasks",
    "pii_policy",
    "status",
    "lifecycle",
    "production_eligible"
  ],
  "properties": {
    "model_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "cost_class": {
      "enum": [
        "free",
        "low",
        "medium",
        "high"
      ]
    },
    "input_cost_per_1m": {
      "type": "number"
    },
    "output_cost_per_1m": {
      "type": "number"
    },
    "allowed_tasks": {
      "type": "array",
      "items": {
        "enum": [
          "R1",
          "R2",
          "R3"
        ]
      }
    },
    "forbidden_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pii_policy": {
      "enum": [
        "allow",
        "redact",
        "forbid"
      ]
    },
    "max_context_tokens": {
      "type": "integer"
    },
    "fallback_model_id": {
      "type": "string"
    },
    "eval_score_threshold": {
      "type": "number"
    },
    "owner": {
      "type": "string"
    },
    "added_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "testing",
        "paused"
      ]
    },
    "lifecycle": {
      "enum": [
        "stable",
        "beta",
        "expired"
      ]
    },
    "api_name_stability": {
      "enum": [
        "stable",
        "experimental",
        "expiring"
      ]
    },
    "production_eligible": {
      "type": "boolean"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "logical_routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concurrency_limit": {
      "type": "integer",
      "minimum": 1
    },
    "legacy_aliases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pricing": {
      "type": "object",
      "required": [
        "currency",
        "unit_tokens",
        "source_authority",
        "source_url",
        "verified_at",
        "budget_basis"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "unit_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "source_authority": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "budget_basis": {
          "enum": [
            "peak",
            "off_peak",
            "free"
          ]
        },
        "peak_windows_utc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "peak_days_utc": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "off_peak": {
          "type": "object"
        },
        "peak": {
          "type": "object"
        },
        "inherits_current_model": {
          "type": "string"
        },
        "announced_pricing_candidate": {
          "type": "object"
        },
        "rate_card_verified": {
          "type": "boolean"
        }
      }
    },
    "promotion_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
