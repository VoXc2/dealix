# Dealix web frontend environment
# Copy to .env.local for local Next.js development.

# Public website canonical URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://dealix.me

# Canonical public API base URL used by browser-safe calls and Vercel.
NEXT_PUBLIC_DEALIX_API_BASE=https://api.dealix.me

# Temporary compatibility alias for older browser surfaces.
NEXT_PUBLIC_API_URL=https://api.dealix.me

# Founder Office public contact surface.
# Email and phone are verified from the founder's current 2026 profile/CV.
# WhatsApp stays explicit so a phone number is never silently assumed to be an
# active WhatsApp Business sender.
NEXT_PUBLIC_FOUNDER_EMAIL=sami.assiri11@gmail.com
NEXT_PUBLIC_FOUNDER_PHONE=+966597788539
NEXT_PUBLIC_WHATSAPP_URL=

# Optional: show internal operational tools in demo/admin surfaces.
NEXT_PUBLIC_SHOW_OPERATIONAL_TOOLS=0

# Recommended: keep privileged operations behind a server-side proxy.
NEXT_PUBLIC_USE_DEALIX_OPS_PROXY=1

# ── Analytics: PostHog ───────────────────────────────────────
# Get from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Error tracking: Sentry ───────────────────────────────────
# Get from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
