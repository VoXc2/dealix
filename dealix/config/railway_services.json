{
  "productionProviderAuthority": {
    "provider": "railway",
    "projectId": "03e6bb4b-bdf5-4aa7-86ed-bc94fa293c0e",
    "environmentId": "38e3d38f-53b2-44fa-a3f9-ef91d863bd83",
    "environmentName": "production",
    "evidenceMode": "read_only_provider_receipt"
  },
  "services": [
    {
      "name": "dealix-api",
      "role": "canonical_api",
      "productionAuthority": true,
      "expectedSourceRepository": "Dealix-sa/dealix",
      "rootDirectory": ".",
      "dockerfilePath": "Dockerfile",
      "railwayConfig": "railway.json",
      "expectedWatchPatterns": [
        "/*.py",
        "/**/*.py",
        "/Dockerfile",
        "/railway.json",
        "/pyproject.toml",
        "/requirements*.txt",
        "/scripts/railway_predeploy.sh",
        "/api/**",
        "/app/**",
        "/db/**",
        "/dealix/**",
        "/alembic/**",
        "/alembic.ini",
        "/config/**",
        "/templates/**",
        "/prompts/**"
      ],
      "healthcheckPath": "/healthz",
      "publicHealthUrl": "https://api.dealix.me/healthz",
      "publicNetworking": true,
      "requiredEnv": [
        "APP_ENV",
        "APP_SECRET_KEY",
        "JWT_SECRET_KEY",
        "API_KEYS",
        "ADMIN_API_KEYS"
      ],
      "optionalEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "SENTRY_DSN",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "GROQ_API_KEY",
        "GOOGLE_API_KEY",
        "DEALIX_ADMIN_API_KEY",
        "CORS_ORIGINS",
        "DEALIX_SUPPRESSION_BACKEND"
      ],
      "runsPredeploy": true
    },
    {
      "name": "founder-os-worker",
      "role": "background_worker",
      "productionAuthority": false,
      "rootDirectory": ".",
      "dockerfilePath": "Dockerfile.worker",
      "startCommand": "python scripts/founder_os_worker.py",
      "publicNetworking": false,
      "requiredEnv": [
        "APP_ENV"
      ],
      "optionalEnv": [
        "DATABASE_URL",
        "FOUNDER_OS_INTERVAL_SECONDS",
        "AGENT_APPROVAL_MODE",
        "AUTO_SEND_ENABLED",
        "EXTERNAL_OUTREACH_ENABLED"
      ],
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "runsPredeploy": false
    },
    {
      "name": "dealix-watchdog",
      "role": "background_watchdog",
      "productionAuthority": false,
      "rootDirectory": ".",
      "dockerfilePath": "Dockerfile.watchdog",
      "startCommand": "python scripts/railway_watchdog.py",
      "publicNetworking": false,
      "cronSchedule": "*/15 * * * *",
      "requiredEnv": [],
      "optionalEnv": [
        "APP_URL",
        "DEALIX_API_URL",
        "DEALIX_HEALTH_PATH"
      ],
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "runsPredeploy": false
    },
    {
      "name": "dealix-frontend",
      "role": "legacy_public_web",
      "productionAuthority": false,
      "rootDirectory": "frontend",
      "dockerfilePath": "Dockerfile",
      "railwayConfig": "frontend/railway.json",
      "healthcheckPath": "/healthz",
      "publicHealthUrl": "https://dealix.me/healthz",
      "publicNetworking": true,
      "requiredEnv": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_USE_DEALIX_OPS_PROXY"
      ],
      "optionalEnv": [
        "DEALIX_OPS_PROXY_SECRET"
      ],
      "runsPredeploy": false
    },
    {
      "name": "dealix-apps-web",
      "role": "canonical_public_web",
      "productionAuthority": true,
      "expectedSourceRepository": "Dealix-sa/dealix",
      "rootDirectory": "apps/web",
      "dockerfilePath": "Dockerfile",
      "railwayConfig": "apps/web/railway.toml",
      "providerConfigFile": "/apps/web/railway.toml",
      "healthcheckPath": "/healthz",
      "publicHealthUrl": "https://dealix.me/healthz",
      "publicNetworking": true,
      "requiredEnv": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL"
      ],
      "optionalEnv": [],
      "runsPredeploy": false
    }
  ]
}
