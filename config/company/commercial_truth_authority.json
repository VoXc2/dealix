  "classes": {
    "CURRENT_AUTHORITY": "May support current Dealix commercial/architecture claims when the exact statement is present and provenance is retained.",
    "HISTORICAL_REFERENCE_NON_AUTHORITATIVE": "Preserve for provenance/history; exclude from current commercial retrieval by default.",
    "DEPRECATED_REPLACED": "Superseded by current policy; exclude from current retrieval by default.",
    "SYNTHETIC_DEMO_ONLY": "Synthetic/demo material; never infer customer relationship, payment, revenue, value or public proof.",
    "UNCLASSIFIED_CONTEXT": "May be used as contextual evidence, but cannot by itself establish current public pricing, current Dealix architecture, verified relationship, revenue or public proof."
  },
  "history_mode": {
    "allowed": true,
    "must_be_explicit": true,
    "label": "HISTORICAL_LOOKUP_ONLY",
    "may_become_current_authority": false
  }
}
