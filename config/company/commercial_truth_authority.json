    "docs/V5_PHASE_E_CHECKLIST.md",
    "docs/V5_PHASE_E_DAY_BY_DAY.md",
    "docs/V6_GTM_EXECUTION_PLAN.md",
    "docs/V7_FIRST_10_WARM_OUTREACH_PACK.md",
    "docs/OBJECTION_HANDLING_V6.md",
    "docs/ops/EXECUTE_NOW_AR.md",
    "docs/ops/FOUNDER_DELIVERY_LADDER_AR.md",
    "docs/ops/FIRST_CUSTOMER_WORKFLOW_AR.md",
    "docs/90_DAY_BUSINESS_EXECUTION_PLAN.md",
    "docs/ops/FIRST_REVENUE_ATTEMPT.md",
    "docs/ops/manual_payment_log.md",
    "docs/revenue/INVOICE_FLOW.md",
    "docs/revenue/REVENUE_READINESS.md",
    "docs/sales-kit/dealix_invoicing_guide.md",
    "docs/sales-kit/dealix_saudi_business_setup.md"
