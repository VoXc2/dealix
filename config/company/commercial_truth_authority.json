{
  "schema": "dealix.commercial_truth_authority.v1",
  "effective_date": "2026-09-13",
  "default_retrieval_mode": "CURRENT_ONLY",
  "purpose": "Prevent historical Dealix prices, offers, architecture counts, synthetic proof, and old runtime assumptions from becoming current commercial authority while preserving explicit historical lookup and provenance.",
  "truth_laws": [
    "research != relationship",
    "public_contact != consent",
    "draft != sent",
    "quote != invoice",
    "invoice != payment",
    "payment != revenue",
    "delivery != customer_value",
    "customer_value != public_proof",
    "HTTP_200 != current_release_identity"
  ],
  "current_invariants": {
    "diagnostic": "FREE",
    "public_fixed_price_authority": false,
    "quote_policy": "customer_specific_after_qualified_discovery",
    "architecture": "agentic_holding_sector_company_mesh",
    "fixed_five_public_architecture_authority": false,
    "synthetic_demo_is_customer_proof": false,
    "research_signal_is_relationship": false,
    "public_fixed_duration_authority": false,
    "scope_duration_policy": "customer_specific_after_qualified_discovery"
  },
  "current_authority": [
    {
      "path": "config/company/fresh_market_execution_policy.json",
      "role": "commercial_and_execution_policy"
    },
    {
      "path": "config/company/agentic_holding_canonical_contract.json",
      "role": "agentic_architecture_contract"
    },
    {
      "path": "docs/architecture/DEALIX_AGENTIC_HOLDING_CANONICAL_2026_09_12.md",
      "role": "agentic_architecture_explanation"
    },
    {
      "path": "config/company/saudi_market_signal_snapshot_2026_09_13.json",
      "role": "evidence_gated_market_signal_snapshot"
    },
    {
      "path": "landing/public-surface-manifest.json",
      "role": "public_surface_authority"
    },
    {
      "path": "landing/assets/data/services-catalog.json",
      "role": "public_service_catalog_authority"
    }
  ],
  "deprecated_prefixes": [
    "docs/phase-e/"
  ],
  "synthetic_prefixes": [
    "business/demo/",
    "docs/assets/demos/",
    "docs/assets/reports/"
  ],
  "historical_exact_paths": [
    "docs/pricing.md",
    "docs/REFUND_SOP.md",
    "docs/SALES_PLAYBOOK.md",
    "docs/B2B_SERVICES_PITCH.md",
