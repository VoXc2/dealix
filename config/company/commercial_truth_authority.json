    "1,500–2,500",
    "١٬٥٠٠–٢٬٥٠٠",
    "PERMANENT_AGENTS == 5",
    "the 5 real sub-agents",
    "5 real sub-agents",
    "5 وكلاء AI",
    "٥ وكلاء AI",
