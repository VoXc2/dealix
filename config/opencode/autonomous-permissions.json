{
  "edit": "allow",
  "read": "allow",
  "glob": "allow",
  "grep": "allow",
  "webfetch": "allow",
  "websearch": "allow",
  "skill": "allow",
  "bash": {
    "*": "allow",
    "git push origin main": "deny",
    "git push origin main *": "deny",
    "git push * main": "deny",
    "git push --force*": "deny",
    "git push -f*": "deny",
    "git update-ref refs/heads/main*": "deny",
    "git reset --hard origin/main*": "deny",
    "gh pr merge*": "deny",
    "gh pr ready*": "deny",
    "gh merge*": "deny",
    "railway up*": "deny",
    "railway redeploy*": "deny",
    "railway environment*production*": "deny",
    "vercel*": "deny",
    "wrangler deploy*": "deny",
    "alembic upgrade head*": "deny",
    "alembic downgrade*": "deny",
    "kubectl delete*": "deny",
    "docker push*": "deny",
    "cat *secret*": "deny",
    "cat *.env": "deny",
    "cat **/.env": "deny",
    "cat /home/dealix/.config/dealix-secrets/*": "deny",
    "cat ~/.openclaw/openclaw.json": "deny",
    "sudo*": "deny",
    "git push --force-with-lease*": "deny",
    "git tag -d *": "deny",
    "railway delete*": "deny",
    "railway variable set*production*": "deny",
    "railway domain*": "deny",
    "vercel remove*": "deny",
    "vercel env rm*": "deny",
    "aws route53*": "deny",
    "gcloud dns*": "deny",
    "cloudflare*": "deny",
    "kubectl delete*production*": "deny",
    "kubectl delete namespace*": "deny",
    "docker system prune*": "deny",
    "docker volume rm*": "deny",
    "rm -rf /*": "deny",
    "rm -rf / *": "deny",
    "gh secret*": "deny",
    "aws secretsmanager*": "deny",
    "vault*": "deny",
    "cat /proc/*/environ*": "deny",
    "env | grep -i secret*": "deny",
    "printenv*SECRET*": "deny"
  }
}
